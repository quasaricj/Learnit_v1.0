/*
 * styles.qss
 *
 * This stylesheet provides a modern, clean look for the Learnit application.
 * Inspired by platforms like Coursera and Udemy.
 */

/* --- Main Window --- */
QMainWindow {
    background-color: #f5f7fa; /* Light grey background */
}

/* --- Sidebar --- */
QTreeView {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    font-size: 14px;
    padding: 10px;
}

QTreeView::item {
    padding: 8px;
}

QTreeView::item:selected {
    background-color: #e7f3ff; /* Light blue for selection */
    color: #0056b3;
    border-radius: 3px;
}

QTreeView::item:hover {
    background-color: #f0f0f0;
}

/* --- Main Content Area --- */
QTextBrowser {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 20px;
    font-size: 16px;
    line-height: 1.6;
}

/* --- Headings --- */
h1 {
    font-size: 28px;
    font-weight: bold;
    color: #333;
    margin-bottom: 15px;
}

h2 {
    font-size: 24px;
    font-weight: bold;
    color: #444;
    margin-bottom: 12px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0056b3;
}

QPushButton:pressed {
    background-color: #004494;
}

/* --- Labels --- */
QLabel {
    font-size: 14px;
    color: #555;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #f0f0f0;
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
