/* General Styling */
QMainWindow {
    background-color: #f0f2f5;
}

QWidget {
    font-family: 'Segoe UI', sans-serif;
    color: #333;
}

/* Sidebar Styling */
QTreeView {
    background-color: #fff;
    border: none;
    font-size: 14px;
}

QTreeView::item {
    padding: 10px;
    border-radius: 5px;
}

QTreeView::item:selected {
    background-color: #e6f0ff;
    color: #0052cc;
}

QTreeView::item:hover {
    background-color: #f5f5f5;
}

/* Content Area Styling */
QTextBrowser {
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 5px;
    padding: 20px;
}

/* Button Styling */
QPushButton {
    background-color: #0052cc;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0065ff;
}

QPushButton:pressed {
    background-color: #004080;
}

/* Dashboard Styling */
#stat_box {
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 15px;
}
